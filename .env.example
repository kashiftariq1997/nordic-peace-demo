# --- Site --------------------------------------------------------------------
# Absolute origin used for canonical URLs, sitemap, robots and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://nordicpeace.com
# Free-shipping threshold in the store's own currency (default 75 when unset)
FREE_SHIPPING_THRESHOLD=75

# --- Shopify Storefront API -------------------------------------------------
# Leave DOMAIN and TOKEN unset to run the storefront on the built-in mock
# catalog (19 sample products, 6 collections) — no Shopify store required.

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token
# Storefront API version (defaults to 2026-07 when unset)
SHOPIFY_API_VERSION=2026-07
# Shared secret verified on POST /api/revalidate (Shopify webhook)
SHOPIFY_REVALIDATION_SECRET=generate-a-long-random-string

# --- Klaviyo ----------------------------------------------------------------
# Missing keys switch /api/newsletter to dev-mode success (nothing is sent).
KLAVIYO_PRIVATE_KEY=
KLAVIYO_LIST_ID=
# Public key loads the Klaviyo JS client (tracking; gated by cookie consent)
KLAVIYO_PUBLIC_KEY=
